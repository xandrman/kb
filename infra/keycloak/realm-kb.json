{
  "realm": "kb",
  "enabled": true,
  "displayName": "Knowledge Base",
  "loginTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "kb-admin", "description": "Роль администратора: админ-панель и Grafana" }
    ]
  },
  "clients": [
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${grafana_client_secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://${domain_name}:8003/login/generic_oauth"],
      "webOrigins": ["https://${domain_name}:8003"],
      "attributes": {
        "post.logout.redirect.uris": "https://${domain_name}:8003/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kb-app",
      "name": "Knowledge Base",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${app_client_secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${domain_name}:8001/auth/keycloak/callback",
        "https://${domain_name}/api/mcp/kb/oauth/callback"
      ],
      "webOrigins": ["https://${domain_name}:8001", "https://${domain_name}"],
      "attributes": {
        "post.logout.redirect.uris": "https://${domain_name}:8001/*",
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://kb-nginx/mcp/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "kb-app audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kb-app",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "librechat",
      "name": "LibreChat",
      "description": "Вход в LibreChat. MCP-токены LibreChat получает отдельно, через клиент kb-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${librechat_client_secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://${domain_name}/oauth/openid/callback"],
      "webOrigins": ["https://${domain_name}"],
      "attributes": {
        "post.logout.redirect.uris": "https://${domain_name}/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${seed_username}",
      "enabled": true,
      "emailVerified": true,
      "email": "${seed_username}@${domain_name}",
      "firstName": "KB",
      "lastName": "Administrator",
      "credentials": [
        { "type": "password", "value": "${seed_password}", "temporary": false }
      ],
      "realmRoles": ["default-roles-kb", "kb-admin"]
    }
  ]
}
