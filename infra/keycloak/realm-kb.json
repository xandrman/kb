{
  "realm": "kb",
  "enabled": true,
  "displayName": "Knowledge Base",
  "loginTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "grafana-admin", "description": "Grafana: роль Admin" },
      { "name": "grafana-editor", "description": "Grafana: роль Editor" },
      { "name": "grafana-viewer", "description": "Grafana: роль Viewer" }
    ]
  },
  "clients": [
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${grafana_client_secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://${domain_name}:3000/login/generic_oauth"],
      "webOrigins": ["http://${domain_name}:3000"],
      "attributes": {
        "post.logout.redirect.uris": "http://${domain_name}:3000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${seed_username}",
      "enabled": true,
      "emailVerified": true,
      "email": "${seed_username}@${domain_name}",
      "firstName": "KB",
      "lastName": "Administrator",
      "credentials": [
        { "type": "password", "value": "${seed_password}", "temporary": false }
      ],
      "realmRoles": ["grafana-admin"]
    }
  ]
}
