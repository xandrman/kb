{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "hf-mcp-server": {
            "type": "remote",
            "url": "https://huggingface.co/mcp?login",
            "enabled": true
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "vendor/bin/sail",
                "artisan",
                "boost:mcp"
            ],
            "cwd": "backend"
        }
    }
}